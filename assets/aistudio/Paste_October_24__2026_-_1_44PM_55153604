                amount = parseFloat(document.getElementById('upiAmount').value); if (isNaN(amount) || amount <= 0) {
                    alert('⚠️ Valid amount'); return; } }
            if (!currentPaymentStudent) return;
            const feeData = state.fees[currentPaymentStudent.id] || { monthlyFee: 600, amount: 0, status: 'due' };
            const today = new Date();
            const year = today.getFullYear().toString();
            const month = today.getMonth();
            const dateStr = today.toISOString().slice(0, 10);
            if (!state.fees[currentPaymentStudent.id]) state.fees[currentPaymentStudent.id] = { status: 'due',
                amount: 0, monthlyFee: 600, lastPaid: '', months: {}, paymentHistory: [] };

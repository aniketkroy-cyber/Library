            renderDashboardCharts();
            renderShiftAndLibrary();
            renderFees(); }

        // ========== SET POPUP ==========
        function openSetPopupForShiftSet(shiftId, setNo, students) { openSetPopup(
                `Shift: ${formatShiftLabel(shiftId)} · ${setNo==='SNA'?'SNA (No Set)':'Set '+setNo}`,
                `Total Students: ${students.length}`, students.map(s => ({ student: s, shift: shiftId }))); }

        function openSetPopupForSet(setNo, entries) { openSetPopup(`Set ${setNo==='SNA'?'SNA (No Set)':setNo} · Assignments`,
                `Total Students: ${entries.length}`, entries); }

        function openSetPopup(title, subtitle, entries) { const modal = document.getElementById('setPopupModal'),
                titleEl = document.getElementById('setPopupTitle'),
                subEl = document.getElementById('setPopupSubtitle'),
                listEl = document.getElementById('setPopupList'); if (!modal || !titleEl || !subEl || !listEl)
                return;
            titleEl.innerText = title;
            subEl.innerText = subtitle;
            listEl.innerHTML = '';
            if (!entries || entries.length === 0) listEl.innerHTML =
                '<p class="text-gray-500 text-[13px] p-2 text-center">⚡ Ye set FREE hai. Koi student assign nahi hai.</p>';
            else { entries.forEach((entry, idx) => { const st = entry.student || entry; const shiftLabel = entry
                        .shift ? ` (${formatShiftLabel(entry.shift)})` : ''; const sd = state.students.find(s =>
                        s.id === st.id) || st; const avatar = sd.avatar ||
                        `https://ui-avatars.com/api/?background=6366F1&color=fff&size=128&name=${encodeURIComponent(sd.name||'S')}`;
                    const div = document.createElement('div');
                    div.className = 'p-3 rounded-md hover:bg-gray-50 border-b border-gray-100 last:border-0';
                    div.innerHTML =
                        `<div class="flex items-center justify-between"><div class="flex items-center gap-3"><img class="h-8 w-8 rounded-full object-cover border border-gray-200" src="${avatar}" alt="avatar" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?background=6366F1&color=fff&size=32&name=${encodeURIComponent(sd.name||'S')}'" /><div><button class="text-left text-indigo-600 hover:underline text-[13px] font-medium student-profile-btn" data-id="${sd.id}">${sd.name}</button><div class="text-[11px] text-gray-500">${sd.mobile||'No mobile'} · Adm: ${sd.admissionDate||'-'}${shiftLabel}</div></div></div><div class="text-[12px] text-gray-400 font-medium">${idx+1}.</div></div>`;
                    listEl.appendChild(div); });
                listEl.querySelectorAll('.student-profile-btn').forEach(btn => { btn.addEventListener('click',
                        () => { const id = btn.dataset.id; const s = state.students.find(s => s.id ===
                            id); if (s) openProfileModalForStudent(s); }); }); }
            modal.classList.remove('hidden'); }

        // ========== SETTINGS ==========
        function initSettings() {
            const nameInp = document.getElementById('ownerNameInput'),
                addrInp = document.getElementById('libraryAddressInput'),
                phoneInp = document.getElementById('libraryPhoneInput'),
                emailInp = document.getElementById('libraryEmailInput'),
                logoUp = document.getElementById('logoUploadInput'),
                logoPrev = document.getElementById('headerLogoPreview'),
                logoPlace = document.getElementById('headerLogoPlaceholder'),
                logoHidden = document.getElementById('headerLogoHidden'),
                clearLogo = document.getElementById('btnClearLogo'),
                saveHead = document.getElementById('btnSaveHeader');
            const qrUp = document.getElementById('qrUploadInput'),
                rmQR = document.getElementById('btnRemoveQR'),
                qrPrev = document.getElementById('qrPreviewImage'),
                qrPrevIcon = document.getElementById('qrPreviewIcon'),
                qrHidden = document.getElementById('qrHidden');
            const upiIdInput = document.getElementById('upiIdInput');
            const saveUpiBtn = document.getElementById('btnSaveUpiId');
            if (nameInp) nameInp.value = state.header.ownerName;
            if (addrInp) addrInp.value = state.header.address || '';
            if (phoneInp) phoneInp.value = state.header.phone || '';
            if (emailInp) emailInp.value = state.header.email || '';
            if (state.header.logoUrl && logoPrev) { logoPrev.src = state.header.logoUrl;
                logoPrev.classList.remove('hidden'); if (logoPlace) logoPlace.classList.add('hidden'); if (logoHidden)
                    logoHidden.value = state.header.logoUrl; }
            if (logoUp) logoUp.addEventListener('change', async function() { const f = this.files[0]; if (f && f
                    .type.startsWith('image/')) { const b64 = await imageToBase64(f); if (logoPrev) { logoPrev
                        .src = b64;
                        logoPrev.classList.remove('hidden'); } if (logoPlace) logoPlace.classList.add('hidden');
                    if (logoHidden) logoHidden.value = b64; } });
            if (clearLogo) clearLogo.addEventListener('click', () => { if (logoPrev) { logoPrev.src = '';
                    logoPrev.classList.add('hidden'); } if (logoPlace) logoPlace.classList.remove('hidden'); if (
                    logoHidden) logoHidden.value = ''; });
            if (qrUp) qrUp.addEventListener('change', async function() { const f = this.files[0]; if (f && f.type
                    .startsWith('image/')) { const b64 = await imageToBase64(f); if (qrPrev) { qrPrev.src =
                        b64;
                        qrPrev.classList.remove('hidden');
                        qrPrevIcon.classList.add('hidden');
                        qrHidden.value = b64; } } });
            if (rmQR) rmQR.addEventListener('click', () => { if (qrPrev) { qrPrev.src = '';
                    qrPrev.classList.add('hidden');
                    qrPrevIcon.classList.remove('hidden');
                    qrHidden.value = ''; } });
            if (saveHead) saveHead.addEventListener('click', async () => { guardAction("Header Settings",
                async () => { state.header.ownerName = nameInp ? nameInp.value || 'Library Name' :
                    'Library Name';
                    state.header.address = addrInp ? addrInp.value || '' : '';
                    state.header.phone = phoneInp ? phoneInp.value || '' : '';
                    state.header.email = emailInp ? emailInp.value || '' : '';
                    state.header.logoUrl = logoHidden?.value || '';
                    state.header.qrCodeUrl = qrHidden?.value || '';
                    await saveHeaderData();
                    renderNewHeader();
                    alert('✅ Header updated'); }); });
            if (saveUpiBtn) saveUpiBtn.addEventListener('click', async () => { guardAction("UPI Settings",
                async () => { state.header.upiId = upiIdInput ? upiIdInput.value.trim() : "";
                    await saveHeaderData();
                    renderNewHeader();
                    alert("✅ UPI ID saved. Dynamic QR will now work."); }); });
            const userNameInp = document.getElementById('userNameInput'),
                userAvUp = document.getElementById('userAvatarUpload'),
                userAvPrev = document.getElementById('userAvatarPreview'),
                userAvFall = document.getElementById('userAvatarPreviewFallback'),
                userAvHidden = document.getElementById('userAvatarHidden'),
                saveUser = document.getElementById('btnSaveUserProfile'); if (userNameInp) userNameInp.value =
                state.header.userName; if (state.header.userAvatar && userAvPrev) { userAvPrev.src = state.header
                    .userAvatar;
                userAvPrev.classList.remove('hidden'); if (userAvFall) userAvFall.classList.add('hidden'); if (
                    userAvHidden) userAvHidden.value = state.header.userAvatar; } if (userAvUp) userAvUp
                .addEventListener('change', async function() { const f = this.files[0]; if (f && f.type.startsWith(
                        'image/')) { const b64 = await imageToBase64(f); if (userAvPrev) { userAvPrev.src =
                            b64;
                        userAvPrev.classList.remove('hidden'); } if (userAvFall) userAvFall.classList.add(
                        'hidden'); if (userAvHidden) userAvHidden.value = b64; } });
            if (saveUser) saveUser.addEventListener('click', async () => { guardAction("User Profile",
                async () => { state.header.userName = userNameInp ? userNameInp.value || 'Admin User' :
                        'Admin User';
                    state.header.userAvatar = userAvHidden?.value || '';
                    await saveHeaderData();
                    renderNewHeader();
                    alert('✅ User profile updated'); }); });
            const shiftTA = document.getElementById('shiftLinesInput'),
                saveShifts = document.getElementById('btnSaveShifts'); if (shiftTA && state.library && state
                .library.shifts) shiftTA.value = state.library.shifts.map(sh => sh.label).join('\n'); if (
                saveShifts) saveShifts.addEventListener('click', async () => { guardAction("Shift Settings",
                async () => { if (!shiftTA) return; const lines = shiftTA.value.split('\n').map(l => l
                        .trim()).filter(l => l); if (!lines.length) { alert('At least one shift'); return; }
                    const newShifts = lines.map((label, i) => ({ id: `shift-${i+1}`, label,
                        capacity: state.library.totalSets })); const validIds = new Set(newShifts.map(
                        sh => sh.id));
                    state.students.forEach(s => { s.assignments = (s.assignments || []).filter(a =>
                            validIds.has(a.shift)); });
                    state.library.shifts = newShifts;
                    await saveLibrary();
                    await saveStudents();
                    populateShiftFilter();
                    alert('✅ Shifts updated'); }); });
            const customize = document.getElementById('btnCustomizeSets'); if (customize) customize.addEventListener(
                'click', async () => { guardAction("Set Customization", async () => { const val = parseInt(
                        prompt('Total sets (1-50):', state.library.totalSets)); if (val && val > 0 && val <=
                        250) { state.library.totalSets = val; if (state.library.shifts) state.library
                            .shifts.forEach(sh => sh.capacity = val); await saveLibrary();
                        alert('✅ Sets updated'); } }); });
            document.getElementById('yearSelector')?.addEventListener('change', () => renderDashboardCharts());
            document.getElementById('toggleBalanceVisibility')?.addEventListener('click', () => { balanceVisible = !
                    balanceVisible;
                document.getElementById('toggleBalanceVisibility').innerText = balanceVisible ? 'Hide' : 'Show';
                renderDashboardCharts();
                renderFees(); });
            document.getElementById('btnWhatsAppReminders')?.addEventListener('click', () => { guardAction(
                    "WhatsApp Reminders", () => openInvoiceReminderModal()); });
            document.getElementById('btnBackupDrive')?.addEventListener('click', () =>
                alert('📁 Google Drive backup feature - You can integrate Google Drive API separately'));
            document.getElementById('btnExportJSON')?.addEventListener('click', () => { guardAction("Export Data",
                () => { const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
                    const a = document.createElement('a');
                    a.href = URL.createObjectURL(blob);
                    a.download = `backup_${new Date().toISOString().slice(0,19)}.json`;
                    a.click();
                    alert('✅ Data exported'); }); });
            document.getElementById('importJSONInput')?.addEventListener('change', async (e) => { const file = e
                    .target.files[0]; if (file) { const reader = new FileReader();
                    reader.onload = async (e) => { try { const imp = JSON.parse(e.target.result);
                            state = imp; if (!state.monthlyCollectionByYear) state
                                .monthlyCollectionByYear = {};
                            if (!state.header) state.header = { ownerName: "Library Name",
                                logoUrl: "", userName: "Admin User", userAvatar: "",
                            qrCodeUrl: "", address: "", phone: "", email: "", upiId: "" };
                            if (!state.header.qrCodeUrl) state.header.qrCodeUrl = "";
                            if (!state.header.address) state.header.address = "";
                            if (!state.header.phone) state.header.phone = "";
                            if (!state.header.email) state.header.email = "";
                            if (!state.header.upiId) state.header.upiId = "";
                            await saveStudents();
                            await saveFees();
                            await saveLibrary();
                            await saveHeaderData();
                            await saveMonthlyCollection();
                            alert('✅ Data imported');
                            renderAll(); } catch (err) { alert('❌ Invalid JSON'); } };
                    reader.readAsText(file); } });
            document.getElementById('closeInvoiceModal')?.addEventListener('click', closeReminderInvoiceModal);
            document.getElementById('invoiceReminderModal')?.addEventListener('click', (e) => { if (e.target ===
                    document.getElementById('invoiceReminderModal')) closeReminderInvoiceModal(); });
            document.getElementById('closeInvoiceModalBtn')?.addEventListener('click', closeInvoiceModal);
            document.getElementById('invoiceModal')?.addEventListener('click', (e) => { if (e.target === document
                    .getElementById('invoiceModal')) closeInvoiceModal(); });
            const manualRefreshBtn = document.getElementById('btnRefreshFeesManual'); if (manualRefreshBtn)
                manualRefreshBtn.addEventListener('click', () => guardAction("Manual Fee Refresh",
                manualFeeRefresh));
        }

        function initForms() {
            document.getElementById('btnNewStudent')?.addEventListener('click', () => openStudentForm());
            document.getElementById('studentFormCancel')?.addEventListener('click', closeStudentForm);
            const saveBtn = document.getElementById('saveStudentBtn'); if (saveBtn) { const newBtn = saveBtn
                    .cloneNode(true);
                saveBtn.parentNode.replaceChild(newBtn, saveBtn);
                newBtn.addEventListener('click', (e) => { e.preventDefault();
                    e.stopPropagation();
                    saveStudentFromForm(); }); }
            document.getElementById('studentFormModal')?.addEventListener('click', (e) => { if (e.target.id ===
                    'studentFormModal') closeStudentForm(); });
            document.getElementById('btnAddAssignment')?.addEventListener('click', () => { const idEl = document
                    .getElementById('studentId'); const curId = idEl ? idEl.value || null : null; const cur =
                    collectAssignmentsFromForm();
                cur.push({ shift: '', set: '' });
                renderAssignmentRows(cur, curId); });
            const avatarUpload = document.getElementById('studentAvatarUpload');
            const avatarCamera = document.getElementById('studentAvatarCamera');
            const deleteAvatarBtn = document.getElementById('btnDeleteStudentAvatar'); if (avatarUpload) avatarUpload
                .addEventListener('change', async function(e) { const f = e.target.files[0]; if (f && f.type
                        .startsWith('image/')) { if (f.size > 10 * 1024) { alert(
                            '❌ Image exceeds 10KB limit. Please choose a smaller image.');
                        this.value = ''; return; } try { const compressed = await compressToMaxSize(f,
                            10);
                        document.getElementById('avatarPreview').src = compressed;
                        document.getElementById('studentAvatar').value = compressed; } catch (err) { alert(
                            '❌ Compression failed: ' + err.message); } } });
            if (avatarCamera) avatarCamera.addEventListener('change', async function(e) { const f = e.target
                    .files[0]; if (f && f.type.startsWith('image/')) { if (f.size > 10 * 1024) { alert(
                            '❌ Image exceeds 10KB limit. Use smaller image.');
                        this.value = ''; return; } try { const compressed = await compressToMaxSize(f,
                            10);
                        document.getElementById('avatarPreview').src = compressed;
                        document.getElementById('studentAvatar').value = compressed; } catch (err) { alert(
                            '❌ Compression failed: ' + err.message); } } });
            if (deleteAvatarBtn) deleteAvatarBtn.addEventListener('click', () => { document.getElementById(
                    'avatarPreview').src = 'https://via.placeholder.com/80?text=Photo';
                document.getElementById('studentAvatar').value = ''; });
            const payModal = document.getElementById('paymentMethodModal'); if (payModal) { payModal.addEventListener(
                    'click', (e) => { if (e.target === payModal) closePaymentModal(); });
                const cfm = document.getElementById('confirmPaymentBtn'); if (cfm) { const newCfm = cfm.cloneNode(
                        true);
                    cfm.parentNode.replaceChild(newCfm, cfm);
                    newCfm.addEventListener('click', confirmPayment); } }
        }

        function setupAttendanceButton() { const btn = document.getElementById('attendanceBtn'); if (btn) btn
                .addEventListener('click', (e) => { e.preventDefault();
                    window.open('https://readbench2.blogspot.com', '_blank'); }); }

        function renderAll() { renderNewHeader();
            renderDashboardCards();
            renderDashboardCharts();
            renderShiftAndLibrary();
            renderStudents();
            renderFees(); }

        // ========== GUARD ACTION ==========
        async function guardAction(featureName, actionCallback) {
            const active = await isSubscriptionActive();
            if (active) { if (actionCallback) actionCallback(); } else showSubscriptionModal(featureName,
                actionCallback);
        }

        // ========== PWA INSTALL ==========
        let deferredPrompt = null;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            const settingsInstallBtn = document.getElementById('installAppBtnSettings'); if (settingsInstallBtn)
                settingsInstallBtn.style.display = 'flex';
        });
        document.getElementById('installAppBtnSettings')?.addEventListener('click', async () => { if (deferredPrompt) {
                deferredPrompt.prompt();
                const { outcome } = await deferredPrompt.userChoice;
                console.log(`User response: ${outcome}`);
                deferredPrompt = null;
            } else { alert('Install prompt not available. You can still add to home screen manually.'); } });
        if (window.matchMedia('(display-mode: standalone)').matches) { const installBtn = document.getElementById(
                'installAppBtnSettings'); if (installBtn) installBtn.style.display = 'none'; }

        // ========== AUTH STATE ==========
        auth.onAuthStateChanged(async (user) => {
            if (user) {
                currentUser = user;
                currentLibraryId = user.uid;
                const cacheLoaded = loadCacheForLibrary(currentLibraryId); if (cacheLoaded) renderAll();
                loginModal.classList.add('hidden');
                registerModal.classList.add('hidden');
                appElement.classList.remove('hidden');
                await loadLibraryData();
                setupDatabaseListeners();
                scheduleDailyFeeReset();
                setupAttendanceButton();
            } else {
                currentUser = null;
                currentLibraryId = null;
                appElement.classList.add('hidden');
                loginModal.classList.remove('hidden');
                if (dailyResetTimeout) clearTimeout(dailyResetTimeout);
                databaseListeners.forEach(off => off());
                databaseListeners = [];
            }
        });

        // ========== DOM READY ==========
        document.addEventListener('DOMContentLoaded', () => { populateYearSelector();
            initNavigation();
            initFilters();
            initForms();
            initSettings();
            initProfileModal();
            setupAttendanceButton(); });

        // ========== PWA MANIFEST & SW ==========
        (function setupPWA() {
            const manifestObj = {
                name: "ReadBench - Library Manager",
                short_name: "ReadBench",
                start_url: ".",
                display: "standalone",
                theme_color: "#4f46e5",
                background_color: "#ffffff",
                icons: [
                    { src: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%234f46e5'/%3E%3Ctext x='50' y='68' font-size='52' text-anchor='middle' fill='white' font-family='monospace'%3ERB%3C/text%3E%3C/svg%3E",
                        sizes: "any", type: "image/svg+xml", purpose: "any" },
                    { src: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' fill='%234f46e5'/%3E%3Ctext x='256' y='350' font-size='280' text-anchor='middle' fill='white' font-family='monospace'%3ERB%3C/text%3E%3C/svg%3E",
                        sizes: "512x512", type: "image/svg+xml", purpose: "any" }
                ]
            };
            const manifestBlob = new Blob([JSON.stringify(manifestObj)], { type: "application/json" });
            const manifestURL = URL.createObjectURL(manifestBlob);
            const manifestLink = document.createElement('link');
            manifestLink.rel = "manifest";
            manifestLink.href = manifestURL;
            document.head.appendChild(manifestLink);

            const swCode = `
          const CACHE_NAME = 'readbench-v1';
          const urlsToCache = [
            '/',
            'https://cdn.tailwindcss.com',
            'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css',
            'https://cdn.jsdelivr.net/npm/chart.js',
            'https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js',
            'https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js',
            'https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js',
            'https://checkout.razorpay.com/v1/checkout.js',
            'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js'
          ].map(url => new URL(url, self.location.origin).href);
          
          self.addEventListener('install', event => {
            event.waitUntil(caches.open(CACHE_NAME).then(cache => cache.addAll(urlsToCache)));
            self.skipWaiting();
          });
          self.addEventListener('fetch', event => {
            event.respondWith(caches.match(event.request).then(response => response || fetch(event.request)));
          });
          self.addEventListener('activate', event => {
            event.waitUntil(clients.claim());
          });
        `;
            const swBlob = new Blob([swCode], { type: 'application/javascript' });
            const swURL = URL.createObjectURL(swBlob);
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register(swURL).catch(err => console.warn('SW failed', err));
            }
        })();
    </script>
</body>

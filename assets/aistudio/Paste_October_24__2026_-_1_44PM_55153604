            let changed = false;
            state.students.forEach(student => {
                const admissionDateStr = student.admissionDate;
                if (!admissionDateStr) return;
                const admissionDate = new Date(admissionDateStr);
                if (isNaN(admissionDate.getTime())) return;
                let feeData = state.fees[student.id];
                if (!feeData) {
                    feeData = { status: 'due', amount: 0, monthlyFee: 600, lastPaid: '',
                        lastResetDate: admissionDateStr, months: {}, paymentHistory: [] };
                    state.fees[student.id] = feeData;
                }
                let lastReset = feeData.lastResetDate ? new Date(feeData.lastResetDate) : admissionDate;
                if (isNaN(lastReset.getTime())) lastReset = admissionDate;
                const nextDue = getNextDueDate(admissionDate, lastReset);
                if (todayUTC >= nextDue) {
                    feeData.status = 'due';
                    feeData.amount = 0;
                    feeData.lastPaid = '';
                    feeData.lastResetDate = todayUTC.toISOString().slice(0, 10);
                    const monthKey = nextDue.toISOString().slice(0, 7);
                    if (!feeData.months) feeData.months = {};
                    feeData.months[monthKey] = 'due';
                    changed = true;
                }
            });
            if (changed) { saveFees();
                console.log("✅ Auto monthly reset completed"); }
            return changed;
        }

        function scheduleDailyFeeReset() {
            if (dailyResetTimeout) clearTimeout(dailyResetTimeout);
            const now = new Date();
            const nextMidnight = new Date(now);
            nextMidnight.setHours(24, 0, 0, 0);
            const msUntilMidnight = nextMidnight - now;
            dailyResetTimeout = setTimeout(() => {
                const changed = refreshFeesBasedOnAdmissionDate();
                if (changed) renderAll();
                scheduleDailyFeeReset();
            }, msUntilMidnight);
        }


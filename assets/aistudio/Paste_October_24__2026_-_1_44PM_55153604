        // ========== IMAGE COMPRESSION ==========
        async function compressToMaxSize(file, maxSizeKB = 10) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = (e) => {
                    const img = new Image();
                    img.src = e.target.result;
                    img.onload = () => {
                        let width = img.width,
                            height = img.height;
                        let quality = 0.7;
                        let attempts = 0;
                        const reduceDim = () => { width = Math.floor(width * 0.85);
                            height = Math.floor(height * 0.85); if (width < 40) width = 40; if (height < 40)
                                height = 40; };
                        const compress = () => {
                            const canvas = document.createElement('canvas');
                            canvas.width = width;
                            canvas.height = height;
                            const ctx = canvas.getContext('2d');
                            ctx.drawImage(img, 0, 0, width, height);
                            let base64 = canvas.toDataURL('image/jpeg', quality);
                            let sizeKB = base64.length * 0.75 / 1024;
                            if (sizeKB <= maxSizeKB) { resolve(base64); return true; }
                            if (attempts >= 15) { reject(new Error(`Image too large after extreme compression (${Math.round(sizeKB)}KB)`));
                                return false; }
                            if (quality > 0.35) { quality -= 0.08;
                                attempts++;
                                compress(); } else { reduceDim();
                                quality = 0.6;
                                attempts++;
                                compress(); }
                        };
                        compress();
                    };
                    img.onerror = () => reject(new Error("Image load error"));
                };
                reader.onerror = () => reject(new Error("File read error"));
            });
        }
